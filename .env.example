# Optional. Defaults to "reality-admin" for this MVP.
ADMIN_PIN=reality-admin

# Optional on Vercel. Enables durable multi-user persistence via Vercel Blob.
# Without it, Vercel uses in-memory storage (resets on cold starts).
# Locally, data is saved to data/store.json.
# BLOB_READ_WRITE_TOKEN=

# Public-place policy: on | off (default on)
# PUBLIC_PLACE_POLICY=on

# Optional Google Street View metadata (preferred public-access heuristic)
# GOOGLE_MAPS_API_KEY=
# STREETVIEW_RADIUS_M=40

# OSM Overpass search radius when Street View is unavailable
# OSM_PUBLIC_RADIUS_M=35
